<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Organic Chemistry IUPAC Exam Companion</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- 3Dmol.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/3Dmol/2.1.0/3Dmol-min.js"></script>

    <style>
        :root {
            /* Light theme variables (Default) */
            --bg-primary: #f3f4f6;
            --bg-secondary: #ffffff;
            --bg-tertiary: #f9fafb;
            --accent-primary: #4f46e5;
            --accent-secondary: #9333ea;
            --text-primary: #111827;
            --text-secondary: #4b5563;
            --text-muted: #9ca3af;
            --success: #10b981;
            --success-glow: rgba(16, 185, 129, 0.08);
            --card-border: rgba(99, 102, 241, 0.08);
            --card-border-hover: rgba(168, 85, 247, 0.3);
            --card-active: rgba(99, 102, 241, 0.08);
            --font-outfit: 'Outfit', sans-serif;
            --font-inter: 'Inter', sans-serif;
            --font-mono: 'Fira Code', monospace;
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.02);
            --shadow-md: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            --shadow-glow: 0 0 15px rgba(99, 102, 241, 0.08);
            
            --image-filter: none;
            --grid-color: rgba(0, 0, 0, 0.02);
        }

        :root.dark-theme {
            /* Dark theme variables */
            --bg-primary: #030712;
            --bg-secondary: #0b0f19;
            --bg-tertiary: #111827;
            --accent-primary: #6366f1;
            --accent-secondary: #a855f7;
            --text-primary: #f3f4f6;
            --text-secondary: #9ca3af;
            --text-muted: #4b5563;
            --success: #10b981;
            --success-glow: rgba(16, 185, 129, 0.15);
            --card-border: rgba(99, 102, 241, 0.12);
            --card-border-hover: rgba(168, 85, 247, 0.4);
            --card-active: rgba(99, 102, 241, 0.2);
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);
            --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.4);
            --shadow-glow: 0 0 20px rgba(99, 102, 241, 0.15);
            
            --image-filter: none;
            --grid-color: rgba(255, 255, 255, 0.015);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            transition: background-color 0.25s, border-color 0.25s, box-shadow 0.25s, color 0.15s;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: var(--font-inter);
            min-height: 100vh;
            padding: 2rem 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-y: scroll;
        }

        /* Chemistry bond network background */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.03) 0%, transparent 40%),
                radial-gradient(circle at 85% 85%, rgba(168, 85, 247, 0.03) 0%, transparent 40%),
                linear-gradient(var(--grid-color) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 30px 30px, 30px 30px;
            z-index: -1;
            pointer-events: none;
        }

        .container {
            max-width: 1250px;
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        header {
            margin-bottom: 0.25rem;
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .header-top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .logo-icon {
            width: 2.4rem;
            height: 2.4rem;
            color: var(--accent-primary);
            filter: drop-shadow(0 0 8px rgba(99, 102, 241, 0.4));
        }

        h1 {
            font-family: var(--font-outfit);
            font-size: 2.4rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.025em;
        }

        /* Theme Toggle Button */
        .theme-toggle-btn {
            background: var(--bg-secondary);
            border: 1px solid var(--card-border);
            color: var(--text-primary);
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
        }

        .theme-toggle-btn:hover {
            border-color: var(--accent-primary);
            color: var(--accent-primary);
            transform: translateY(-1px);
            box-shadow: var(--shadow-glow);
        }

        .sun-icon {
            display: none;
            width: 1.2rem;
            height: 1.2rem;
        }

        .moon-icon {
            display: block;
            width: 1.2rem;
            height: 1.2rem;
        }

        :root.dark-theme .sun-icon {
            display: block;
        }

        :root.dark-theme .moon-icon {
            display: none;
        }

        .subtitle {
            color: var(--text-secondary);
            font-size: 1.05rem;
            font-weight: 400;
        }

        .hebrew-hint {
            direction: rtl;
            font-family: var(--font-inter);
            color: var(--accent-primary);
            font-size: 0.95rem;
            font-weight: 600;
            margin-top: 0.15rem;
        }

        /* Dashboard Stats */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            background: var(--bg-secondary);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 1.25rem;
            box-shadow: var(--shadow-sm);
        }

        .stat-card {
            text-align: center;
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
        }

        :root.dark-theme .stat-card {
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        .stat-card:last-child {
            border-right: none;
        }

        .stat-val {
            font-family: var(--font-outfit);
            font-size: 1.7rem;
            font-weight: 750;
            color: var(--text-primary);
        }

        .stat-label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Search Section */
        .search-area {
            position: sticky;
            top: 1rem;
            z-index: 100;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            background: rgba(243, 244, 246, 0.85);
            backdrop-filter: blur(20px);
            border: 1px solid var(--card-border);
            padding: 1rem;
            border-radius: 20px;
            box-shadow: var(--shadow-md);
        }

        :root.dark-theme .search-area {
            background: rgba(3, 7, 18, 0.85);
        }

        .search-bar-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .search-input {
            width: 100%;
            background-color: var(--bg-secondary);
            border: 2px solid var(--card-border);
            border-radius: 12px;
            padding: 0.75rem 1.25rem 0.75rem 2.8rem;
            color: var(--text-primary);
            font-family: var(--font-inter);
            font-size: 1rem;
            outline: none;
            transition: all 0.2s;
        }

        .search-input:focus {
            border-color: var(--accent-primary);
            box-shadow: var(--shadow-glow);
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            width: 1.1rem;
            height: 1.1rem;
            color: var(--text-secondary);
            pointer-events: none;
        }

        .search-input:focus + .search-icon {
            color: var(--accent-primary);
        }

        .clear-btn {
            position: absolute;
            right: 1rem;
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            display: none;
            padding: 0.15rem;
            border-radius: 50%;
        }

        .clear-btn:hover {
            color: var(--text-primary);
            background-color: rgba(0, 0, 0, 0.05);
        }
        
        :root.dark-theme .clear-btn:hover {
            background-color: rgba(255, 255, 255, 0.08);
        }

        .shortcut-badge {
            position: absolute;
            right: 1rem;
            background: rgba(0, 0, 0, 0.03);
            border: 1px solid rgba(0, 0, 0, 0.08);
            color: var(--text-secondary);
            padding: 0.15rem 0.35rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-family: var(--font-mono);
            pointer-events: none;
        }

        :root.dark-theme .shortcut-badge {
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .search-input:focus ~ .shortcut-badge {
            display: none;
        }

        /* Filters Section */
        .filters-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            max-height: 80px;
            overflow-y: auto;
            padding-right: 0.25rem;
        }

        .filters-wrapper::-webkit-scrollbar {
            width: 3px;
        }
        .filters-wrapper::-webkit-scrollbar-thumb {
            background: var(--bg-tertiary);
            border-radius: 3px;
        }

        .filter-btn {
            background: var(--bg-secondary);
            border: 1px solid var(--card-border);
            color: var(--text-secondary);
            padding: 0.3rem 0.65rem;
            border-radius: 8px;
            cursor: pointer;
            font-family: var(--font-inter);
            font-size: 0.78rem;
            font-weight: 555;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .filter-btn:hover {
            border-color: var(--accent-primary);
            color: var(--text-primary);
        }

        .filter-btn.active {
            background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
            border-color: transparent;
            color: #fff;
            box-shadow: 0 4px 10px rgba(99, 102, 241, 0.2);
        }

        .filter-count {
            background: rgba(0, 0, 0, 0.06);
            color: var(--text-secondary);
            padding: 0.05rem 0.3rem;
            border-radius: 4px;
            font-size: 0.68rem;
            font-weight: 600;
        }
        
        .filter-btn.active .filter-count {
            background: rgba(0, 0, 0, 0.15);
            color: #fff;
        }

        /* Layout Grid */
        .main-layout-wrapper {
            display: grid;
            grid-template-columns: 1fr 420px;
            gap: 1.25rem;
            align-items: start;
            width: 100%;
        }

        /* Molecules list */
        .molecules-list {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

        .molecule-card {
            background: var(--bg-secondary);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 0.75rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .molecule-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 4px;
            background: transparent;
            transition: background-color 0.2s;
        }

        .molecule-card:hover {
            border-color: var(--card-border-hover);
            transform: translateX(4px);
            box-shadow: var(--shadow-md);
        }

        .molecule-card.active-nav {
            background: var(--card-active);
            border-color: var(--accent-primary);
            box-shadow: var(--shadow-glow);
        }
        
        .molecule-card.active-nav::before {
            background: var(--accent-primary);
        }

        .molecule-card.copied {
            border-color: var(--success) !important;
            background: var(--success-glow) !important;
        }

        .molecule-card.copied::before {
            background: var(--success) !important;
        }

        .card-left {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            flex: 1;
            min-width: 0;
        }

        .card-id-name {
            display: flex;
            align-items: baseline;
            gap: 0.5rem;
            min-width: 0;
        }

        .mol-id {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 600;
            flex-shrink: 0;
        }

        .mol-name {
            font-family: var(--font-mono);
            font-size: 0.98rem;
            font-weight: 500;
            color: var(--text-primary);
            word-break: break-all;
            line-height: 1.35;
        }

        .highlight {
            background-color: rgba(99, 102, 241, 0.15);
            color: var(--accent-primary);
            border-radius: 2px;
            font-weight: 600;
            border-bottom: 2px solid var(--accent-primary);
        }
        
        :root.dark-theme .highlight {
            background-color: rgba(99, 102, 241, 0.35);
            color: #fff;
        }

        .badges-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem;
            align-items: center;
        }

        .badge {
            padding: 0.12rem 0.4rem;
            border-radius: 5px;
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: capitalize;
            border: 1px solid rgba(0,0,0,0.03);
        }

        /* Curated category badge styles */
        .badge.alkene { background: rgba(16, 185, 129, 0.1); color: #059669; border-color: rgba(16, 185, 129, 0.2); }
        .badge.alkyne { background: rgba(245, 158, 11, 0.1); color: #d97706; border-color: rgba(245, 158, 11, 0.2); }
        .badge.stereochemistry { background: rgba(168, 85, 247, 0.1); color: #7c3aed; border-color: rgba(168, 85, 247, 0.2); }
        .badge.haloalkane { background: rgba(59, 130, 246, 0.1); color: #2563eb; border-color: rgba(59, 130, 246, 0.2); }
        .badge.cyclic { background: rgba(6, 182, 212, 0.1); color: #0891b2; border-color: rgba(6, 182, 212, 0.2); }
        .badge.aromatic { background: rgba(236, 72, 153, 0.1); color: #db2777; border-color: rgba(236, 72, 153, 0.2); }
        .badge.alcohol { background: rgba(239, 68, 68, 0.1); color: #dc2626; border-color: rgba(239, 68, 68, 0.2); }
        .badge.ether { background: rgba(139, 92, 246, 0.1); color: #6d28d9; border-color: rgba(139, 92, 246, 0.2); }
        .badge.carboxylic-acid { background: rgba(244, 63, 94, 0.1); color: #e11d48; border-color: rgba(244, 63, 94, 0.2); }
        .badge.ester { background: rgba(20, 184, 166, 0.1); color: #0d9488; border-color: rgba(20, 184, 166, 0.2); }
        .badge.amide { background: rgba(234, 179, 8, 0.1); color: #ca8a04; border-color: rgba(234, 179, 8, 0.2); }
        .badge.anhydride { background: rgba(249, 115, 22, 0.1); color: #ea580c; border-color: rgba(249, 115, 22, 0.2); }
        .badge.alkane { background: rgba(156, 163, 175, 0.1); color: #4b5563; border-color: rgba(156, 163, 175, 0.2); }
        .badge.aldehyde { background: rgba(219, 39, 119, 0.1); color: #be185d; border-color: rgba(219, 39, 119, 0.2); }
        .badge.ketone { background: rgba(124, 58, 237, 0.1); color: #5b21b6; border-color: rgba(124, 58, 237, 0.2); }
        .badge.other { background: rgba(75, 85, 99, 0.1); color: #374151; border-color: rgba(75, 85, 99, 0.2); }

        :root.dark-theme .badge.alkene { background: rgba(16, 185, 129, 0.12); color: #34d399; }
        :root.dark-theme .badge.alkyne { background: rgba(245, 158, 11, 0.12); color: #fbbf24; }
        :root.dark-theme .badge.stereochemistry { background: rgba(168, 85, 247, 0.12); color: #c084fc; }
        :root.dark-theme .badge.haloalkane { background: rgba(59, 130, 246, 0.12); color: #60a5fa; }
        :root.dark-theme .badge.cyclic { background: rgba(6, 182, 212, 0.12); color: #22d3ee; }
        :root.dark-theme .badge.aromatic { background: rgba(236, 72, 153, 0.12); color: #f472b6; }
        :root.dark-theme .badge.alcohol { background: rgba(239, 68, 68, 0.12); color: #f87171; }
        :root.dark-theme .badge.ether { background: rgba(139, 92, 246, 0.12); color: #a78bfa; }
        :root.dark-theme .badge.carboxylic-acid { background: rgba(244, 63, 94, 0.12); color: #fb7185; }
        :root.dark-theme .badge.ester { background: rgba(20, 184, 166, 0.12); color: #2dd4bf; }
        :root.dark-theme .badge.amide { background: rgba(234, 179, 8, 0.12); color: #fde047; }
        :root.dark-theme .badge.anhydride { background: rgba(249, 115, 22, 0.12); color: #ffedd5; }
        :root.dark-theme .badge.alkane { background: rgba(156, 163, 175, 0.12); color: #d1d5db; }
        :root.dark-theme .badge.aldehyde { background: rgba(219, 39, 119, 0.12); color: #f472b6; }
        :root.dark-theme .badge.ketone { background: rgba(124, 58, 237, 0.12); color: #ddd6fe; }
        :root.dark-theme .badge.other { background: rgba(75, 85, 99, 0.12); color: #9ca3af; }

        .property-meta {
            font-size: 0.72rem;
            color: var(--text-secondary);
            display: flex;
            gap: 0.8rem;
            align-items: center;
        }

        .prop-item {
            display: flex;
            align-items: center;
            gap: 0.2rem;
        }

        .prop-label {
            color: var(--text-muted);
            font-weight: 600;
        }

        .prop-val {
            color: var(--text-secondary);
            font-family: var(--font-mono);
        }

        .card-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        .molecule-preview-wrapper {
            width: 48px;
            height: 48px;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .molecule-preview-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: var(--image-filter);
            transition: transform 0.2s ease;
        }

        .molecule-card:hover .molecule-preview-wrapper img {
            transform: scale(1.15);
        }

        .structure-fallback {
            width: 1.3rem;
            height: 1.3rem;
            color: var(--text-muted);
            opacity: 0.25;
        }

        .copy-btn {
            background: var(--bg-tertiary);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 0.4rem 0.65rem;
            font-family: var(--font-inter);
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            box-shadow: var(--shadow-sm);
        }

        .copy-btn:hover {
            background: var(--accent-primary);
            color: #fff;
            border-color: transparent;
        }

        .copy-btn.success-btn {
            background: var(--success) !important;
            color: #fff !important;
            border-color: transparent !important;
        }

        .btn-icon {
            width: 0.8rem;
            height: 0.8rem;
        }

        /* Detail Sidebar */
        .detail-sidebar {
            position: sticky;
            top: 5.5rem;
            background: var(--bg-secondary);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 1.25rem;
            box-shadow: var(--shadow-md);
            max-height: calc(100vh - 7.5rem);
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1.1rem;
        }

        .detail-sidebar::-webkit-scrollbar {
            width: 4px;
        }
        .detail-sidebar::-webkit-scrollbar-thumb {
            background: var(--bg-tertiary);
            border-radius: 4px;
        }

        .sidebar-welcome {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 4rem 1.5rem;
            color: var(--text-secondary);
            gap: 1rem;
        }

        .welcome-molecule-icon {
            width: 4rem;
            height: 4rem;
            color: var(--accent-primary);
            opacity: 0.8;
            animation: spin-slow 15s linear infinite;
        }

        @keyframes spin-slow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .sidebar-welcome h3 {
            font-family: var(--font-outfit);
            font-size: 1.2rem;
            font-weight: 650;
            color: var(--text-primary);
        }

        .sidebar-welcome p {
            font-size: 0.85rem;
            line-height: 1.5;
            color: var(--text-muted);
        }

        .sidebar-details.hidden,
        .sidebar-welcome.hidden {
            display: none !important;
        }

        .sidebar-header {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .detail-mol-id {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--accent-primary);
            font-weight: 700;
            text-transform: uppercase;
        }

        .detail-mol-name {
            font-family: var(--font-mono);
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--text-primary);
            line-height: 1.35;
        }

        .viewer-container {
            position: relative;
            width: 100%;
            height: 280px;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--card-border);
            background: var(--bg-tertiary);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .molecule-3d-viewer {
            width: 100%;
            height: 100%;
        }

        .viewer-fallback-img {
            width: 80%;
            height: 80%;
            object-fit: contain;
            z-index: 5;
            filter: var(--image-filter);
        }

        .viewer-fallback-img.hidden {
            display: none !important;
        }

        .viewer-controls {
            position: absolute;
            bottom: 0.6rem;
            left: 0.6rem;
            right: 0.6rem;
            display: flex;
            justify-content: space-between;
            z-index: 10;
        }

        .viewer-ctrl-btn {
            background: rgba(15, 22, 38, 0.75);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            padding: 0.3rem 0.6rem;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 550;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .viewer-ctrl-btn:hover {
            background: var(--accent-primary);
            color: #fff;
            border-color: transparent;
        }

        .ctrl-icon {
            width: 0.8rem;
            height: 0.8rem;
        }

        .detail-properties {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.6rem;
        }

        .detail-prop-card {
            background: var(--bg-tertiary);
            border: 1px solid var(--card-border);
            border-radius: 10px;
            padding: 0.5rem 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
        }

        .detail-prop-label {
            font-size: 0.68rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .detail-prop-val {
            font-family: var(--font-inter);
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .detail-prop-val.mono {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            word-break: break-all;
        }

        .smiles-help {
            margin-top: 0.45rem;
            border: 1px solid var(--card-border);
            border-radius: 9px;
            background: var(--bg-secondary);
            overflow: hidden;
        }

        .smiles-help-toggle {
            width: 100%;
            border: none;
            background: transparent;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            padding: 0.45rem 0.55rem;
            cursor: pointer;
            font-size: 0.72rem;
            font-weight: 600;
            text-align: left;
        }

        .smiles-help-toggle:hover {
            background: var(--bg-tertiary);
        }

        .smiles-help-toggle .caret {
            font-size: 0.62rem;
            color: var(--text-muted);
            transition: transform 0.18s ease;
        }

        .smiles-help.open .smiles-help-toggle .caret {
            transform: rotate(180deg);
        }

        .smiles-help-body {
            display: none;
            border-top: 1px solid var(--card-border);
            padding: 0.48rem 0.55rem 0.56rem;
            font-size: 0.69rem;
            color: var(--text-secondary);
            line-height: 1.45;
        }

        .smiles-help.open .smiles-help-body {
            display: block;
        }

        .smiles-help-body p {
            margin: 0 0 0.32rem;
        }

        .smiles-help-body p:last-child {
            margin-bottom: 0;
        }

        .smiles-help-body code {
            font-family: var(--font-mono);
            font-size: 0.67rem;
            color: var(--text-primary);
            background: var(--bg-tertiary);
            border: 1px solid var(--card-border);
            border-radius: 6px;
            padding: 0.02rem 0.26rem;
        }

        .detail-categories {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
        }

        .sidebar-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

        .sidebar-action-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            padding: 0.55rem 0.75rem;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            background: var(--bg-tertiary);
            border: 1px solid var(--card-border);
            color: var(--text-primary);
        }

        .sidebar-action-btn:hover {
            border-color: var(--accent-primary);
            color: var(--accent-primary);
            background: var(--bg-secondary);
            box-shadow: var(--shadow-glow);
        }

        .sidebar-action-btn.primary {
            grid-column: span 2;
            background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
            color: #fff;
            border: none;
        }

        .sidebar-action-btn.primary:hover {
            opacity: 0.9;
            color: #fff;
        }

        .action-icon {
            width: 0.85rem;
            height: 0.85rem;
        }

        .sidebar-close-btn {
            display: none;
            position: absolute;
            top: 1rem;
            right: 1.25rem;
            font-size: 1.4rem;
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            width: 2rem;
            height: 2rem;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
        }

        .sidebar-close-btn:hover {
            background-color: rgba(0,0,0,0.05);
            color: var(--text-primary);
        }

        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            z-index: 999;
            display: none;
        }

        /* Empty state */
        .empty-state {
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 4rem 2rem;
            text-align: center;
            background: var(--bg-secondary);
            border: 2px dashed var(--card-border);
            border-radius: 16px;
            box-shadow: var(--shadow-sm);
        }

        .empty-icon {
            width: 3.5rem;
            height: 3.5rem;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .empty-title {
            font-family: var(--font-outfit);
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.3rem;
        }

        .empty-desc {
            color: var(--text-secondary);
            font-size: 0.9rem;
            max-width: 350px;
        }

        /* Toast notification */
        .toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: var(--bg-secondary);
            border: 1px solid var(--success);
            border-radius: 10px;
            padding: 0.75rem 1.1rem;
            box-shadow: var(--shadow-md);
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: var(--text-primary);
            font-size: 0.85rem;
            font-weight: 500;
            z-index: 9999;
            transform: translateY(100px);
            opacity: 0;
            pointer-events: none;
            transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.255);
            backdrop-filter: blur(10px);
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
            pointer-events: auto;
        }

        .toast-icon-wrapper {
            background: var(--success);
            padding: 0.2rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
        }

        .toast-text {
            font-family: var(--font-inter);
        }

        /* Responsive styling */
        @media (max-width: 1024px) {
            .main-layout-wrapper {
                grid-template-columns: 1fr;
            }
            .detail-sidebar {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                top: auto;
                max-height: 85vh;
                z-index: 1000;
                border-radius: 24px 24px 0 0;
                border-top: 1px solid var(--card-border);
                box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.15);
                transform: translateY(100%);
                transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            }
            .detail-sidebar.open {
                transform: translateY(0);
            }
            .sidebar-overlay.open {
                display: block;
            }
            .sidebar-close-btn {
                display: flex;
            }
        }

        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }
            h1 {
                font-size: 2rem;
            }
            .stats-row {
                grid-template-columns: repeat(2, 1fr);
                gap: 0.75rem;
            }
            .stat-card {
                border-right: none;
            }
            .stat-card:nth-child(odd) {
                border-right: 1px solid rgba(0, 0, 0, 0.05);
            }
            :root.dark-theme .stat-card:nth-child(odd) {
                border-right: 1px solid rgba(255, 255, 255, 0.05);
            }
            .molecule-card {
                padding: 0.8rem;
            }
        }
            /* View Mode Dropdown Select */
        .view-mode-selector {
            width: 100%;
            margin-bottom: 0.65rem;
        }

        .view-mode-select {
            width: 100%;
            padding: 0.6rem 0.85rem;
            border-radius: 10px;
            background-color: var(--bg-tertiary);
            border: 1px solid var(--card-border);
            color: var(--text-primary);
            font-family: var(--font-inter);
            font-size: 0.85rem;
            font-weight: 600;
            outline: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .view-mode-select:focus {
            border-color: var(--accent-primary);
            box-shadow: var(--shadow-glow);
        }

        /* 2D Viewer Styles */
        .molecule-2d-viewer {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-tertiary);
            padding: 1rem;
            box-sizing: border-box;
            overflow: hidden;
        }

        .molecule-2d-viewer.hidden {
            display: none !important;
        }

        .molecule-2d-content {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* SVG styles inside 2D content */
        .molecule-2d-content svg {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
        }
        
        .molecule-2d-content .condensed-text-display {
            font-family: var(--font-mono);
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--accent-primary);
            text-align: center;
            word-break: break-all;
            padding: 2rem;
            background: var(--bg-secondary);
            border: 1px dashed var(--card-border);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
        }
    
        /* ── Card thumbnail ── */
        .card-thumb {
            width: 72px;
            height: 54px;
            flex-shrink: 0;
            border-radius: 8px;
            overflow: hidden;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card-thumb svg { width: 100%; height: 100%; }
        .card-thumb.no-svg { opacity: 0.3; }

        /* ── Star button ── */
        .btn-star {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            color: var(--text-muted);
            transition: color 0.2s, transform 0.2s;
            font-size: 1.1rem;
            line-height: 1;
            flex-shrink: 0;
        }
        .btn-star:hover { color: #f59e0b; transform: scale(1.2); }
        .btn-star.starred { color: #f59e0b; }

        /* ── Starred filter ── */
        .filter-btn.starred-filter.active { background: #f59e0b22; border-color: #f59e0b66; color: #f59e0b; }

        /* ── Quiz mode toolbar ── */
        .quiz-toolbar {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 1.5rem;
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--card-border);
            font-size: 0.82rem;
        }
        .quiz-toolbar.hidden { display: none; }
        .btn-quiz-toggle {
            padding: 0.3rem 0.9rem;
            border-radius: 8px;
            border: 1.5px solid var(--accent-primary);
            background: none;
            color: var(--accent-primary);
            font-family: var(--font-outfit);
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-quiz-toggle.active {
            background: var(--accent-primary);
            color: #fff;
        }
        .quiz-score {
            margin-left: auto;
            display: flex;
            gap: 0.5rem;
            align-items: center;
            font-family: var(--font-mono);
            color: var(--text-secondary);
        }
        .quiz-score .score-got { color: #22c55e; font-weight: 700; }
        .quiz-score .score-miss { color: #ef4444; font-weight: 700; }

        /* ── Quiz name blur ── */
        body.quiz-mode .mol-name {
            filter: blur(5px);
            transition: filter 0.25s;
            cursor: pointer;
            user-select: none;
        }
        body.quiz-mode .molecule-card:hover .mol-name { filter: blur(3px); }
        body.quiz-mode .molecule-card.quiz-revealed .mol-name { filter: none; }
        .quiz-reveal-hint {
            font-size: 0.68rem;
            color: var(--accent-primary);
            opacity: 0;
            transition: opacity 0.2s;
        }
        body.quiz-mode .molecule-card:hover .quiz-reveal-hint { opacity: 1; }
        body.quiz-mode .quiz-answer-btns { display: flex; }
        .quiz-answer-btns {
            display: none;
            gap: 0.4rem;
            margin-top: 0.35rem;
        }
        .quiz-btn-got, .quiz-btn-miss {
            padding: 2px 8px;
            border-radius: 6px;
            border: none;
            font-size: 0.7rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .quiz-btn-got  { background: #22c55e22; color: #22c55e; }
        .quiz-btn-miss { background: #ef444422; color: #ef4444; }

        /* ── Stereo badges ── */
        .stereo-badges-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            margin-top: 0.15rem;
        }
        .stereo-badge {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 5px;
            letter-spacing: 0.03em;
        }
        .stereo-badge.rs  { background: #8b5cf622; color: #a78bfa; border: 1px solid #8b5cf644; }
        .stereo-badge.ez  { background: #0ea5e922; color: #38bdf8; border: 1px solid #0ea5e944; }
        .stereo-badge.geo { background: #f59e0b22; color: #fbbf24; border: 1px solid #f59e0b44; }

        /* ── Functional group highlight ── */
        .badge.active-highlight {
            outline: 2px solid var(--accent-primary);
            outline-offset: 2px;
            box-shadow: 0 0 8px var(--accent-primary);
        }

        /* ── 2D capture button hover ── */
        #btn2dCapture:hover { background: rgba(99,102,241,0.85) !important; }

        /* ── Skeleton loader ── */
        .skeleton-card {
            height: 74px;
            border-radius: 12px;
            background: linear-gradient(90deg, var(--bg-secondary) 25%, var(--bg-tertiary) 50%, var(--bg-secondary) 75%);
            background-size: 200% 100%;
            animation: skeleton-shimmer 1.2s infinite;
            border: 1px solid var(--card-border);
        }
        @keyframes skeleton-shimmer {
            0%   { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        /* ── Card float on select ── */
        @keyframes card-float-in {
            0%   { transform: translateY(0); box-shadow: var(--shadow-sm); }
            50%  { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(99,102,241,0.18); }
            100% { transform: translateY(0); box-shadow: var(--shadow-sm); }
        }
        .molecule-card.selected { animation: card-float-in 0.4s ease; }

        /* ── View-mode select glow ── */
        .view-mode-select:focus-within,
        .view-mode-select:focus {
            outline: 2px solid var(--accent-primary);
            box-shadow: 0 0 0 4px rgba(99,102,241,0.15);
        }
        #selectViewMode {
            font-family: var(--font-outfit);
            font-weight: 550;
        }

        /* ── Confetti canvas ── */
        #confetti-canvas {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 99999;
        }

        /* ── Font consistency patch ── */
        .prop-label, .prop-val, .badge, .filter-btn,
        .viewer-ctrl-btn span, .detail-mol-id {
            font-family: var(--font-outfit), var(--font-mono), monospace;
        }
        .detail-mol-id { font-family: var(--font-mono); }
        .prop-val.smiles-val, .condensed-text-display { font-family: var(--font-mono); }

        </style>
</head>
<body>
    <!-- Confetti canvas -->
    <canvas id="confetti-canvas"></canvas>

    <!-- Quiz toolbar -->
    <div class="quiz-toolbar hidden" id="quizToolbar">
        <span style="color:var(--text-secondary);font-family:var(--font-outfit);font-weight:600;">🎓 Quiz Mode</span>
        <button class="btn-quiz-toggle active" id="btnQuit Quiz" onclick="toggleQuiz()" style="margin-left:0.25rem;">Exit Quiz</button>
        <div class="quiz-score">
            <span>✓ <span class="score-got" id="scoreGot">0</span></span>
            <span>✗ <span class="score-miss" id="scoreMiss">0</span></span>
            <button onclick="resetQuizScore()" style="background:none;border:1px solid var(--card-border);border-radius:6px;padding:2px 8px;color:var(--text-muted);cursor:pointer;font-size:0.75rem;">Reset</button>
        </div>
    </div>

<div class="container">
    <header>
        <div class="header-top-row">
            <div class="logo-area">
                <svg class="logo-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
                <h1>IUPAC Answer Key</h1>
            </div>
            <button class="theme-toggle-btn" id="themeToggleBtn" title="Toggle Dark/Light Mode">
                <!-- Sun Icon (shown in dark theme) -->
                <svg class="sun-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4-9H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
                </svg>
                <!-- Moon Icon (shown in light theme) -->
                <svg class="moon-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                </svg>
            </button>
        </div>
        <div class="subtitle">Searchable reference list for organic chemistry exams</div>
        <div class="hebrew-hint">חיפוש והעתקה מהירה של שמות IUPAC למבחן בכימיה אורגנית</div>
    </header>

    <!-- Stats Dashboard -->
    <section class="stats-row">
        <div class="stat-card">
            <span class="stat-val" id="stat-total">0</span>
            <span class="stat-label">Total Names</span>
        </div>
        <div class="stat-card">
            <span class="stat-val" id="stat-stereo">0</span>
            <span class="stat-label">Stereo</span>
        </div>
        <div class="stat-card">
            <span class="stat-val" id="stat-halo">0</span>
            <span class="stat-label">Haloalkanes</span>
        </div>
        <div class="stat-card">
            <span class="stat-val" id="stat-unsaturated">0</span>
            <span class="stat-label">Alkenes/Alkynes</span>
        </div>
    </section>

    <!-- Sticky Search Area -->
    <section class="search-area">
        <div class="search-bar-wrapper">
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637z" />
            </svg>
            <input type="text" class="search-input" id="searchInput" placeholder="Type to search (e.g. hexene, dimethyl, (E)...)" autocomplete="off" spellcheck="false" autofocus>
            <button class="clear-btn" id="clearBtn">
                <svg style="width:1.1rem; height:1.1rem" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            <span class="shortcut-badge" id="shortcutBadge">/</span>
        </div>

        <!-- Filter Tags -->
        <div class="filters-wrapper" id="filtersContainer">
            <button class="filter-btn starred-filter" id="btnStarredFilter" title="Show starred only">⭐ Starred</button>
            <button class="filter-btn" id="btnQuizMode" title="Enter Quiz Mode">🎓 Quiz</button>
            <button class="filter-btn active" data-category="all">
                <span>All</span>
                <span class="filter-count" id="count-all">0</span>
            </button>
        </div>
        
                <div class="kbd-item"><kbd>↓</kbd> <kbd>↑</kbd> Navigate</div>
                <div class="kbd-item"><kbd>Enter</kbd> Copy selected</div>
                <div class="kbd-item"><kbd>Esc</kbd> Clear</div>
            </div>
        </div>
    </section>

    <!-- Main Layout Dual Column -->
    <div class="main-layout-wrapper">
        <!-- Molecules Results List -->
        <main class="molecules-list" id="moleculesList">
            <!-- Rendered dynamically -->
        </main>
        
        <!-- 3D & Detail Sidebar -->
        <aside class="detail-sidebar" id="detailSidebar">
            <button class="sidebar-close-btn" id="btnSidebarClose" title="Close details">&times;</button>
            
            <!-- Default Welcome state -->
            <div class="sidebar-welcome" id="sidebarWelcome">
                <div class="welcome-molecule-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="3" />
                        <circle cx="6" cy="6" r="2" />
                        <circle cx="18" cy="18" r="2" />
                        <circle cx="6" cy="18" r="2" />
                        <circle cx="18" cy="6" r="2" />
                        <line x1="8" y1="8" x2="10" y2="10" />
                        <line x1="16" y1="16" x2="14" y2="14" />
                        <line x1="8" y1="16" x2="10" y2="14" />
                        <line x1="16" y1="8" x2="14" y2="10" />
                    </svg>
                </div>
                <h3>Select a Molecule</h3>
                <p>Click on any compound card or navigate with arrow keys to view its interactive 3D model, chemical properties, and download PyMOL sessions.</p>
            </div>
            
            <!-- Active detail state -->
            <div class="sidebar-details hidden" id="sidebarDetails">
                <div class="sidebar-header">
                    <span class="detail-mol-id" id="detailMolId">#000</span>
                    <h2 class="detail-mol-name" id="detailMolName">Compound Name</h2>
                    <div class="stereo-badges-row" id="detailStereoBadges"></div>
                </div>
                
                <!-- View Mode Selector -->
                <div class="view-mode-selector">
                    <select id="selectViewMode" class="view-mode-select">
                        <option value="3d">3D View (WebGL)</option>
                        <option value="skeletal">Skeletal (2D)</option>
                        <option value="wedgedash">Wedge-Dash (2D)</option>
                        <option value="lewis">Lewis Structure</option>
                        <option value="full">Full Structural</option>
                        <option value="condensed">Condensed Formula</option>
                        <option value="fischer" id="optFischer" style="display:none;">Fischer Projection</option>
                        <option value="newman" id="optNewman" style="display:none;">Newman Projection</option>
                        <option value="chair" id="optChair" style="display:none;">Chair Conformation</option>
                        <option value="boat" id="optBoat" style="display:none;">Boat Conformation</option>
                    </select>
                </div>
                
                <div class="viewer-container">
                    <div id="molecule-3d-viewer" class="molecule-3d-viewer"></div>
                    <!-- 2D View Container -->
                    <div id="molecule-2d-viewer" class="molecule-2d-viewer hidden" style="position:relative;">
                        <div id="molecule-2d-content" class="molecule-2d-content"></div>
                        <!-- 2D Capture button -->
                        <button id="btn2dCapture" title="Download as PNG"
                            style="position:absolute;bottom:0.6rem;right:0.6rem;z-index:15;
                                   background:rgba(15,22,38,0.75);backdrop-filter:blur(8px);
                                   border:1px solid rgba(255,255,255,0.1);color:#fff;
                                   padding:0.3rem 0.65rem;border-radius:8px;font-size:0.7rem;
                                   font-weight:600;cursor:pointer;display:flex;align-items:center;
                                   gap:0.35rem;font-family:var(--font-outfit);transition:background 0.2s;">
                            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15a2.25 2.25 0 002.25-2.25V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/>
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"/>
                            </svg>
                            Capture
                        </button>
                    </div>
                    <!-- Pre-rendered PyMOL Fallback Image -->
                    <img id="viewer-fallback-img" src="" alt="Molecule Preview" class="viewer-fallback-img hidden">
                    
                    <!-- Expand Button -->
                    <button class="viewer-expand-btn" id="btnExpandViewer" title="Expand to fullscreen" style="position:absolute;top:0.5rem;right:0.5rem;z-index:15;background:rgba(15,22,38,0.75);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.1);color:#fff;padding:0.3rem;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75v4.5m0-4.5h-4.5m4.5 0L15 9m5.25 11.25v-4.5m0 4.5h-4.5m4.5 0L15 15" />
                        </svg>
                    </button>
                    
                    <div class="viewer-controls" id="viewerControls">
                        <button class="viewer-ctrl-btn" id="btnSpin" title="Toggle Auto-Rotation">
                            <svg class="ctrl-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 7.89M9 11l3 3L22 4" />
                            </svg>
                            <span id="spinText">Spin Off</span>
                        </button>
                        <button class="viewer-ctrl-btn" id="btnStyle" title="Change Style">
                            <span id="styleText">Style: Ball & Stick</span>
                        </button>
                        <button class="viewer-ctrl-btn" id="btnCapture" title="Download PNG Snapshot">
                            <svg class="ctrl-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15a2.25 2.25 0 002.25-2.25V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                            </svg>
                            <span>Capture</span>
                        </button>
                    </div>
                </div>
                
                <div class="detail-properties">
                    <div class="detail-prop-card">
                        <span class="detail-prop-label">Formula</span>
                        <span class="detail-prop-val" id="detailFormula">-</span>
                    </div>
                    <div class="detail-prop-card">
                        <span class="detail-prop-label">MW</span>
                        <span class="detail-prop-val" id="detailWeight">-</span>
                    </div>
                    <div class="detail-prop-card" style="grid-column: span 2;">
                        <span class="detail-prop-label">SMILES</span>
                        <span class="detail-prop-val mono" id="detailSmiles">-</span>
                        <div class="smiles-help" id="smilesHelpBanner">
                            <button class="smiles-help-toggle" id="smilesHelpToggle" type="button" aria-expanded="false" aria-controls="smilesHelpBody">
                                <span>How to read SMILES</span>
                                <span class="caret">▼</span>
                            </button>
                            <div class="smiles-help-body" id="smilesHelpBody">
                                <p><code>C</code> chain letters are atoms. Numbers close rings, for example <code>C1CCCCC1</code>.</p>
                                <p><code>=</code> and <code>#</code> indicate double and triple bonds.</p>
                                <p><code>()</code> marks branches: <code>CC(C)C</code> means a 3-carbon chain with a methyl branch on the middle carbon.</p>
                                <p><code>@</code> and <code>@@</code> mark tetrahedral configurations (enantiomers) options, corresponding to R/S assignments.</p>
                                <p><code>[]</code> is for explicit atoms/charges/isotopes: <code>[NH4+]</code>, <code>[Cl-]</code>, <code>[13CH3]</code>.</p>
                                <p><code>/</code> and <code>\</code> set alkene geometry: <code>C/C=C/C</code> is trans (E), while <code>C/C=C\C</code> is cis (Z).</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="detail-categories" id="detailCategories">
                    <!-- Badges go here -->
                </div>
                
                <div class="sidebar-actions">
                    <button class="sidebar-action-btn primary" id="btnCopyName">
                        <svg class="action-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m-2 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>Copy IUPAC Name</span>
                    </button>
                    <a class="sidebar-action-btn" id="btnDownloadPse" href="#" download>
                        <svg class="action-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span>PyMOL Session (.pse)</span>
                    </a>
                    <a class="sidebar-action-btn" id="btnDownloadSdf" href="#" download>
                        <svg class="action-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <span>Structure (.sdf)</span>
                    </a>
                    <a class="sidebar-action-btn" id="btnPubchem" href="#" target="_blank" rel="noopener">
                        <svg class="action-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                        <span>PubChem View</span>
                    </a>
                </div>
            </div>
        </aside>
    </div>

    <!-- Empty state -->
    <div class="empty-state" id="emptyState">
        <svg class="empty-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="empty-title">No IUPAC Names Found</h3>
        <p class="empty-desc">We couldn't find any chemical names matching your query in the answer key.</p>
    </div>
</div>

<!-- Mobile drawer overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Toast notification -->
<div class="toast" id="toast">
    <div class="toast-icon-wrapper">
        <svg style="width:0.9rem; height:0.9rem" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
    </div>
    <span class="toast-text" id="toastText">Copied!</span>
</div>

